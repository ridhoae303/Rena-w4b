<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/font</item>
        <item name="android:colorAccent">#00A884</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">#111B21</item>
        <item name="android:navigationBarColor">#111B21</item>
        <item name="android:windowBackground">@drawable/window_background</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:textColorPrimary">#ECF0F2</item>
        <item name="android:textColorSecondary">#A0B0B8</item>
        <item name="android:textColorHint">#708088</item>
        <item name="android:editTextColor">#ECF0F2</item>
        <item name="android:alertDialogTheme">@style/RenaDialogTheme</item>
    </style>

    <style name="AppThemeLight" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/font</item>
        <item name="android:colorAccent">#00A884</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">#F5F7F8</item>
        <item name="android:navigationBarColor">#F5F7F8</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@drawable/window_background_light</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:textColorPrimary">#101B20</item>
        <item name="android:textColorSecondary">#5D6C74</item>
        <item name="android:textColorHint">#8C989E</item>
        <item name="android:editTextColor">#101B20</item>
        <item name="android:alertDialogTheme">@style/RenaDialogTheme</item>
    </style>

    <style name="RenaDialogTheme" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">@font/font</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:colorAccent">#00A884</item>
        <item name="android:textColorPrimary">#ECF0F2</item>
        <item name="android:textColorSecondary">#A0B0B8</item>
        <item name="android:buttonBarButtonStyle">@style/RenaDialogButton</item>
    </style>

    <style name="RenaDialogButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">#00A884</item>
        <item name="android:fontFamily">@font/font</item>
    </style>

    <style name="RenaDialogAnim" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/dialog_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_out</item>
    </style>

    <style name="SplashTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/font</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
